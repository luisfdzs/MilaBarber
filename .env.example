# Copia este fichero a .env.local y rellena los valores.
# .env.local está gitignorado: NUNCA se sube al repositorio.

# --- Sanity (panel de contenido, en /admin) ---
# projectId y dataset NO son secretos: van en el HTML de cualquier web con Sanity.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Token de ESCRITURA. Sólo hace falta para scripts que escriban en el CMS.
# Se crea en sanity.io/manage › API › Tokens con permiso "Editor". Es un secreto.
SANITY_API_WRITE_TOKEN=

# Secreto compartido con el webhook de Sanity que revalida la web al publicar.
# Cualquier cadena larga y aleatoria; el mismo valor va en sanity.io/manage › API › Webhooks.
SANITY_REVALIDATE_SECRET=

# --- Base de datos (usuarios, citas) ---
# Cadena de conexión de MongoDB Atlas. Es un secreto: lleva usuario y contraseña.
MONGODB_URI=

# --- Sesiones ---
# Firma las cookies de sesión. Genera una con: npx auth secret
AUTH_SECRET=

# URL pública del despliegue. En Vercel se deduce sola; en local no hace falta.
# AUTH_URL=http://localhost:3000

# --- Zona horaria ---
# NO se configura aquí ni en Vercel: `TZ` es una variable RESERVADA en Vercel y el panel
# rechaza crearla. La zona la fija `instrumentation.ts` en el arranque del servidor, que
# además hace que el desarrollo local coincida con producción sin depender de la máquina.
# Ver el comentario largo de ese fichero.

# --- Correo saliente (verificación de cuenta, olvido de contraseña, aviso de cita) ---
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
